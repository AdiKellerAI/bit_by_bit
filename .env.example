# Copy to .env and fill in real values locally. Never commit .env.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Telegram (primary Agent channel — MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Admin's own Telegram platform_user_id (from the `users` table, or message the bot once and
# check `SELECT platform_user_id FROM users`) — sensitive-data alerts are sent here (PROJECT-SPEC.md §4.2(d))
ADMIN_TELEGRAM_CHAT_ID=

# Database / cache
# POSTGRES_* configure the postgres container itself; keep DATABASE_URL in sync with them
# for local docker-compose (e.g. postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_PORT/$POSTGRES_DB)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DATABASE_URL=
REDIS_URL=

# n8n (self-hosted, local dev)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# dbmate (schema migrations) — not secrets, just points dbmate at database/ instead of its
# ./db default
DBMATE_MIGRATIONS_DIR=database/migrations
DBMATE_SCHEMA_FILE=database/schema.sql

# WhatsApp Cloud API — deferred/optional, leave blank until steps 7/8 in
# docs/project_setup/PREREQUISITES.md are unblocked
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
BUSINESS_ACCOUNT_ID=
