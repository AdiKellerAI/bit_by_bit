    {
      "id": "pg-select-community-links-1",
      "name": "Select Community Shared Links",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        690
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT COALESCE(g.links, '[]'::json) AS links\nFROM (SELECT 1) AS dummy\nLEFT JOIN LATERAL (\n  SELECT json_agg(json_build_object('title', title, 'source_url', source_url, 'final_description_he', final_description_he) ORDER BY created_at) AS links\n  FROM weekly_content_items\n  WHERE content_type = 'community_shared_link' AND created_at > now() - interval '7 days'\n) g ON true\nLIMIT 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2ceb9b4a66d1d908",
          "name": "Postgres (bit_by_bit)"
        }
      }
    },
    {
      "id": "code-aggregate-community-links-1",
      "name": "Aggregate Community Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        690
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const links = $json.links || [];\nreturn [{ json: { count: links.length, links } }];\n"
      }
    },
    {
      "id": "if-any-community-links-1",
      "name": "Any Community Links?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        690
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      }
    },
    {
      "id": "telegram-send-no-links-1",
      "name": "Send No Links This Week",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        820,
        760
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.ADMIN_TELEGRAM_CHAT_ID }}",
        "text": "No community-shared links this week.",
        "additionalFields": {}
